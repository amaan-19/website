---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from '../components/BlogPost.astro';
const allPosts = Object.values(import.meta.glob('./blog_posts/*.md', { eager: true })).reverse();
const pageTitle = "blog";
---
<BaseLayout pageTitle={pageTitle}>
  <ul class="blog-post-list">
    {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} description={post.frontmatter.description} date={post.frontmatter.pubDate} />)}
  </ul>
</BaseLayout>