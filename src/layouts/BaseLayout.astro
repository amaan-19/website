---
import "../styles/global.css";

import Sidebar from "../components/Sidebar.astro";
import MainContent from "../components/MainContent.astro";

const { pageTitle } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Red+Hat+Mono:ital,wght@0,300..700;1,300..700&display=swap');
    </style>
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{"amaan khan"}</title>
  </head>
  <body>
    <div class="page-grid">
      <div id="empty-column-1"></div>
      <Sidebar />
      <div id="empty-column-2"></div>
      <MainContent pageTitle={pageTitle}>
        <slot />
      </MainContent>
      <div id="empty-column-3"></div>
    </div>
    <script>
      import "../scripts/page-reloader";
      import "../scripts/menu";
      import "../scripts/content-resizer";
    </script>
  </body>
</html>